{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "type": "timeseries",
      "title": "请求速率 (QPS)",
      "targets": [
        {
          "expr": "sum(rate(xmind_requests_total[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req/s"
        }
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "type": "timeseries",
      "title": "请求延迟 (P99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(xmind_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "type": "stat",
      "title": "上传成功率",
      "targets": [
        {
          "expr": "sum(rate(xmind_uploads_total{status=\"success\"}[5m])) / sum(rate(xmind_uploads_total[5m]))",
          "legendFormat": "成功率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 0.95,
                "color": "yellow"
              },
              {
                "value": 0.99,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "type": "stat",
      "title": "转换成功率",
      "targets": [
        {
          "expr": "sum(rate(xmind_conversions_total{status=\"success\"}[5m])) / sum(rate(xmind_conversions_total[5m]))",
          "legendFormat": "{{format}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "type": "stat",
      "title": "总请求量 (5分钟)",
      "targets": [
        {
          "expr": "sum(increase(xmind_requests_total[5m]))",
          "legendFormat": "总量"
        }
      ]
    },
    {
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "type": "timeseries",
      "title": "上传文件大小",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(xmind_upload_size_bytes_bucket[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(xmind_upload_size_bytes_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "type": "timeseries",
      "title": "转换耗时 (P99)",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(xmind_conversion_duration_seconds_bucket[5m])) by (le, format))",
          "legendFormat": "{{format}} P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "type": "timeseries",
      "title": "临时文件数量",
      "targets": [
        {
          "expr": "xmind_temp_files",
          "legendFormat": "文件数"
        }
      ]
    },
    {
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "type": "timeseries",
      "title": "磁盘使用量",
      "targets": [
        {
          "expr": "xmind_disk_usage_bytes{type=\"temp\"}",
          "legendFormat": "临时文件"
        },
        {
          "expr": "xmind_disk_usage_bytes{type=\"output\"}",
          "legendFormat": "输出文件"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": [
    "xmind",
    "prometheus"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "XMind 转 Markdown 监控仪表盘",
  "uid": "xmind-to-md"
}
